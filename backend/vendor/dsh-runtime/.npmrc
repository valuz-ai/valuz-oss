# file: dependencies (valuz-plugins/*) must land in node_modules as REAL
# copies, not symlinks — the desktop build stages `node_modules` alone
# (build-desktop.sh Phase A5 `cp -R node_modules`), so a symlink into
# ../valuz-plugins would dangle in the packaged app. Consequence: after
# editing a valuz-plugins package, refresh the copy with
#   bash scripts/vendor-dsh-runtime.sh --update
install-links=true
