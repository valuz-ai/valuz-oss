<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Verbatim copy of the entitlements the claude-agent-sdk ships on its
       _bundled/claude (Bun/JSC) binary — Developer ID: Anthropic PBC
       (Q6L2SF6YDW), SDK 0.2.128 / CLI 2.1.220. JSC needs allow-jit +
       allow-unsigned-executable-memory under hardened runtime, or the CLI
       dies on use with "ReferenceError: SharedArrayBuffer is not defined". -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
