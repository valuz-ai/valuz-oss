/* Scoped to this plugin's root ([data-valuz-app-plugin="__PLUGIN_ID__"]) by the build.
   Use the host's CSS variables so light / dark themes just work. */
.plugin-page {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 24px;
  color: var(--color-ink-body);
}

.plugin-page__title {
  margin: 0;
  font-size: 18px;
  font-weight: 600;
  color: var(--color-ink-heading);
}

.plugin-page__list {
  margin: 0;
  padding: 0;
  list-style: none;
}
